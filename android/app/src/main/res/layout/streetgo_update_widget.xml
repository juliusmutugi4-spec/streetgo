<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="@drawable/streetgo_widget_background">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="STREETGO"
            android:textColor="#00F5A0"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.14"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● LIVE"
            android:textColor="#00F5A0"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

    </LinearLayout>

    <!-- TITLE -->
    <TextView
        android:id="@+id/widget_heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Top Updates"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <!-- SUBTITLE -->
    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Stay connected with what matters."
        android:textColor="#8FA39B"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- DIVIDER -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="13dp"
        android:background="#2200F5A0" />

    <!-- UPDATE 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_icon_1"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="●"
            android:textColor="#00F5A0"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_update_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Welcome to StreetGO"
                android:textColor="#F4F7F5"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_time_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Just now"
                android:textColor="#697871"
                android:textSize="10sp"
                android:maxLines="1" />

        </LinearLayout>

    </LinearLayout>

    <!-- UPDATE 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_icon_2"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="✦"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_update_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your latest updates will appear here"
                android:textColor="#DCE5E1"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_time_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Stay tuned"
                android:textColor="#697871"
                android:textSize="10sp"
                android:maxLines="1" />

        </LinearLayout>

    </LinearLayout>

    <!-- FOOTER -->
    <TextView
        android:id="@+id/widget_open"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:gravity="center"
        android:text="OPEN STREETGO   ›"
        android:textColor="#00F5A0"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

</LinearLayout>